{
  "name": "gannet_light",
  "version": 2,
  "introduced_by": "ribshore",
  "notes": "The Gannet Head light: a white tower 27 m tall on a stepped basalt and fieldstone plinth, tapering, banded three times in black, stair windows climbing round it in recesses with stone sills and lintels, a gabled porch with a transomed door up a flight of steps between cheek walls with iron rails, a corbelled gallery on twelve brackets with a railing, a glazed lantern, and a domed cap with a vent, a ball and a lightning rod, 35 m to its tip. Built 1894, kept sixty years, empty since; it does not decay, since a 30 m column crumbles metres off its top at any age and takes the lantern with it. Door on local -Z.",
  "size": [49, 140, 49],
  "anchor": [24, 0, 24],
  "foundation": 6,
  "level": true,
